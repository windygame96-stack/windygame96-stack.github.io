# AI 生成课程 - 模型 API Key 配置说明
#
# 使用方法：
# 1. 复制这个文件为 .env.local（不会被提交到 git）
# 2. 在 .env.local 里填入你拥有的任意一个或多个模型的 API Key（不需要全部填）
# 3. 保存后告诉我"配置好了"，我会读取并同步写入 Supabase Edge Function 的密钥，
#    之后"创建课程"页选择"AI 生成"即可实际调用。
#
# 调用优先级由 AI_PROVIDER_ORDER 决定，按顺序尝试，前面失败或未配置 Key 会自动跳到下一个，
# 全部失败才会回退到规则算法。默认顺序：zhipu,moonshot,deepseek,groq

# 前端 Supabase 连接（publishable/anon key 可以进入前端构建，service_role 绝对不要放这里）
VITE_SUPABASE_URL=https://supabase-api-prod.verdent.ai/p/p6536aba27bd9649715e8
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VERDENT_OAUTH_INITIATE_URL=

# Edge Function 允许的网页来源，逗号分隔
ALLOWED_ORIGINS=https://www.escapefromhongye.xyz

# 智谱 GLM（glm-4-flash，长期免费额度）
# 获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 月之暗面 Kimi（moonshot-v1-8k）
# 获取地址：https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# DeepSeek（deepseek-chat）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq（llama-3.1-8b-instant，海外免费额度）
# 获取地址：https://console.groq.com/keys
GROQ_API_KEY=

# 可选：自定义调用优先级，逗号分隔，留空则使用默认顺序 zhipu,moonshot,deepseek,groq
AI_PROVIDER_ORDER=
